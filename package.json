{
  "name": "v3rne",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env packages/server/src/index.ts",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "seed": "bun packages/server/scripts/seed-demo.ts",
    "test": "bun test",
    "test:web": "bun run --cwd packages/web test",
    "typecheck": "bunx tsc --noEmit -p packages/server/tsconfig.json && bun run --cwd packages/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
